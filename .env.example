# Environment Configuration for ControlPlane.ai
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=sqlite:///./controlplane.db

# Cryptographic Secret for Approval Tokens (Must be kept secret on server)
CONTROLPLANE_TOKEN_SECRET=controlplane_super_secret_hmac_key_change_in_production_2026

# Token TTL (Seconds)
TOKEN_TTL_SECONDS=300

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Provider Configuration
DEMO_MODE=true
AI_PROVIDER=mock
